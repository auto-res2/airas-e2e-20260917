  "hypotheses": [
    {
      "id": "h1",
      "statement": "ラベルスムージング（LS）で学習した教師から蒸留した生徒は、hard target で学習した教師から蒸留した生徒より較正誤差（ECE）が低く、この差は低温度（T=1）でも高温度（T=4）でも現れる。すなわち生徒が教師の confidence を継承する現象は画像分類の LS 教師にも成り立ち、LS の較正効果は蒸留を通じて生徒に伝わる。",
      "assumptions": [
        "15-bin の ECE が較正の代表指標である（c1, c2, c3）",
        "CIFAR-100、ResNet-18 教師と小型 CNN 生徒、単一 seed の結果が他のデータセット・規模に一般化する（c1, c2, c3）",
        "accuracy は表で報告するが criterion にしていない。LS 教師の生徒の精度が大きく劣らないことは本研究では測るだけで検証しない（c1, c3）"
      ],
      "grounded_on": [
        "s1.p1",
        "s1.p2",
        "s2.p1",
        "s2.p2",
        "s3.p1"
      ],
      "claims": [
        {
          "id": "c1",
          "statement": "T=1 で LS 教師から蒸留した生徒の ECE は、hard 教師から蒸留した生徒の ECE より 0.01 以上低い。",
          "rationale": "s2 が精度の観点で推奨する設定（LS 教師、T=1）で較正が生徒に継承されていれば、h1 の主節が成り立つ。",
          "verifier": {
            "kind": "seyval"
          },
          "designs": [
            {
              "id": "d1",
              "summary": "CIFAR-100 で ResNet-18 教師（hard / LS α=0.1）を学習し、同一の小型 CNN 生徒を KD（KL 0.9 + CE 0.1、T=1）で蒸留、test 10k で 15-bin ECE を測る。",
              "runs": [
                {
                  "run_id": "student-kd-hard-t1",
                  "description": "生徒、teacher-hard の logits から T=1 で蒸留",
                  "params": {
                    "mode": "full"
                  }
                },
                {
                  "run_id": "student-kd-ls-t1",
                  "description": "生徒、teacher-ls の logits から T=1 で蒸留",
                  "params": {
                    "mode": "full"
                  }
                }
              ]
            }
          ],
          "cites_passages": [
            "s2.p2",
            "s3.p1",
            "s3.p2"
          ],
          "criterion": {
            "metric": "ece",
            "subject": "student-kd-ls-t1",
            "reference": "student-kd-hard-t1",
            "op": "<=",
            "margin": -0.01
          },
          "prediction": {
            "low": -0.06,
            "high": -0.01,
            "basis": "s1 が報告する LS による教師の ECE 低減の一部が生徒に残ると想定"
          }
        },
        {
          "id": "c2",
          "statement": "LS（α=0.1）で学習した ResNet-18 教師の ECE は、hard target で学習した教師の ECE より 0.02 以上低い。",
          "rationale": "教師側に較正差がなければ生徒への継承は検証不能なので、s1 の較正効果を本設定で再現することが h1 の前提を担う。",
          "verifier": {
