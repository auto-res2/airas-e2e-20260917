      "passages": [
        {
          "id": "s2.p1",
          "node_type": "claim",
          "quote": "This systematic diffusion essentially curtails the benefits (as claimed by Shen et al. (2021b)) obtained by distilling from an LS-trained teacher, thereby rendering KD at increased temperatures ineffective"
